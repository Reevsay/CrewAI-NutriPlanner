# =============================================================================
# CREWAI-NUTRIPLANNER CONFIGURATION
# =============================================================================
# Copy this file to .env and add your actual API keys

# =============================================================================
# REQUIRED: GOOGLE GEMINI API KEY
# =============================================================================
# Get your FREE API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# =============================================================================
# OPTIONAL: ENHANCED FEATURES
# =============================================================================
# These APIs provide enhanced functionality but system works without them

# USDA Nutrition API (FREE - no key required)
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Nutritionix API (Optional - for enhanced nutrition data)
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here

# Kroger API (Optional - for real-time grocery prices)
KROGER_CLIENT_ID=your_kroger_client_id_here
KROGER_CLIENT_SECRET=your_kroger_client_secret_here

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# System behavior settings
SYSTEM_MODE=hybrid
USE_FALLBACK_DATA=true

# Application Settings
LOG_LEVEL=INFO
CACHE_DURATION_HOURS=24
MAX_RETRIES=3
REQUEST_TIMEOUT=30
DEBUG=false
ENVIRONMENT=production

# CrewAI Configuration (prevents errors)
CHROMA_OPENAI_API_KEY=dummy_key_for_testing